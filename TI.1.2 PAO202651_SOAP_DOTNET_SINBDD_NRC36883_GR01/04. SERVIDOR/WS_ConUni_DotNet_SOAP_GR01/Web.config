<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>

  <system.serviceModel>
    <!-- 1. Registro de la clase que inyecta el inspector de seguridad -->
    <extensions>
      <behaviorExtensions>
        <add name="tokenValidator"
             type="ec.edu.monster.Seguridad.TokenHeaderBehaviorExtensionElement, WS_ConUni_DotNet_SOAP_GR01" />
      </behaviorExtensions>
    </extensions>

    <!-- 2. Comportamientos de endpoint y de servicio -->
    <behaviors>
      <endpointBehaviors>
        <behavior name="SeguridadEndpointBehavior">
          <tokenValidator />
        </behavior>
      </endpointBehaviors>

      <serviceBehaviors>
        <behavior name="MetadatosBehavior">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <!-- 3. Servicio y endpoints -->
    <services>
      <service name="ec.edu.monster.Servicios.WSConversorUnidades"
               behaviorConfiguration="MetadatosBehavior">
        <endpoint address=""
                  binding="basicHttpBinding"
                  contract="ec.edu.monster.Servicios.IWSConversorUnidades"
                  behaviorConfiguration="SeguridadEndpointBehavior" />
      </service>
    </services>

    <!-- Necesario con IIS / IIS Express para convivir con varios bindings -->
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
  </system.serviceModel>

  <system.webServer>
    <!--
        No agregar <modules runAllManagedModulesForAllRequests="true" /> aqui:
        esa seccion esta bloqueada por defecto en IIS (overrideModeDefault="Deny")
        y provoca HTTP 500.19 (0x80070021). WCF con .svc no la necesita.
      -->
    <!--
        Para explorar la raíz del sitio durante la depuración, deje el valor en true.
        Cámbielo a false antes de desplegar para no revelar la estructura de carpetas.
      -->
    <directoryBrowse enabled="true" />
  </system.webServer>

</configuration>
