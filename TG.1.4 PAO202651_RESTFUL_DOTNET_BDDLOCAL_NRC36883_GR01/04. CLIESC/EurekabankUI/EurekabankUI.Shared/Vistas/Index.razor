@page "/"
@inject ec.edu.monster.Servicios.EstadoAplicacion EstadoApp
@inject ec.edu.monster.Servicios.FabricaEstrategiaBackend Fabrica
@inject NavigationManager NavManager

<div class="espe-background">
    <div class="espe-card espe-login-card">
        <div class="row g-0">

            <div class="col-md-6 espe-login-media">
                <img src="/sullivan_computer.jpg" class="img-fluid" alt="Imagen Login" />
            </div>

            <div class="col-md-6 p-4 p-md-5 d-flex flex-column justify-content-center">
                <div class="text-center mb-4">
                    <h4 class="espe-title mb-0">
                        <i class="bi bi-bank text-primary me-2"></i>Eureka Bank
                    </h4>
                    <small class="text-secondary">
                        <i class="bi bi-people me-1"></i>Sistema Bancario - Grupo 1
                    </small>
                </div>

                <!-- Selección del entorno de conexión -->
                <div class="mb-4">
                    <label class="espe-section-label">
                        <i class="bi bi-hdd-network me-1"></i>Entorno de conexión
                    </label>
                    <div class="espe-backend-grid">
                        @foreach (var backend in Enum.GetValues<TipoBackend>())
                        {
                            var seleccionado = EstadoApp.BackendActual == backend;
                            <button type="button"
                                    class="espe-backend-option @(seleccionado ? "is-selected" : "")"
                                    @onclick='() => EstadoApp.EstablecerBackend(backend)'>
                                <span class="espe-backend-indicator"></span>
                                <span class="espe-backend-name">@NombreBackend(backend)</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Usuario -->
                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control espe-form-control" @bind="usuario" placeholder="Ingrese su usuario" />
                    </div>
                </div>

                <!-- Contraseña -->
                <div class="mb-4">
                    <label class="form-label">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control espe-form-control" @bind="contrasenia" placeholder="Ingrese su contraseña" />
                    </div>
                </div>

                <button class="btn espe-btn-primary w-100" @onclick="HacerLogin">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                </button>

                @if (!string.IsNullOrEmpty(mensajeErrorLogin))
                {
                    <div class="alert alert-danger mt-3 mb-0 p-2 text-center d-flex align-items-center justify-content-center gap-2" style="font-size:.85rem;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@mensajeErrorLogin</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string usuario = "";
    private string contrasenia = "";
    private string mensajeErrorLogin = "";

    private async Task HacerLogin()
    {
        mensajeErrorLogin = "";

        if (string.IsNullOrWhiteSpace(usuario) || string.IsNullOrWhiteSpace(contrasenia))
        {
            mensajeErrorLogin = "Por favor, complete ambos campos.";
            return;
        }

        try
        {
            var adaptadorAuth = Fabrica.ObtenerAdaptadorAutenticacion(EstadoApp.BackendActual);
            EstadoApp.TokenActual = await adaptadorAuth.IniciarSesionAsync(usuario, contrasenia);

            if (EstadoApp.TokenActual == "OK")
            {
                NavManager.NavigateTo("/menu");
            }
        }
        catch (Exception ex)
        {
            mensajeErrorLogin = TraductorErrores.MensajeAmigable(ex, EstadoApp.BackendActual);
        }
    }

    private static string NombreBackend(TipoBackend backend) => backend switch
    {
        TipoBackend.JavaSoap => "Java SOAP",
        TipoBackend.JavaRest => "Java REST",
        TipoBackend.DotNetSoap => ".NET SOAP",
        TipoBackend.DotNetRest => ".NET REST",
        _ => backend.ToString()
    };
}