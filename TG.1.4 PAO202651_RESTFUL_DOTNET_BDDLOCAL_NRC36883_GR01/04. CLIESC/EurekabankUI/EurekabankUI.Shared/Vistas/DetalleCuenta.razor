@page "/detalle-cuenta/{cuenta}"
@inject ec.edu.monster.Servicios.EstadoAplicacion EstadoApp
@inject ec.edu.monster.Servicios.FabricaEstrategiaBackend Fabrica
@inject NavigationManager NavManager

<div class="container mt-5 mb-5">
    <!-- Botón Volver -->
    <button class="btn btn-link mb-3 text-decoration-none" @onclick='() => NavManager.NavigateTo("/cuentas")'>
        <i class="bi bi-arrow-left me-1"></i> Volver a la lista
    </button>

    @if (cargando)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando información y movimientos...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@error</div>
        </div>
    }
    else if (datos != null)
    {
        <!-- 1. Tarjeta con el Detalle de la Cuenta -->
        <div class="espe-card p-5 mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 class="espe-title">@datos.NombreCliente</h2>
                    <p class="text-muted mb-1">
                        <i class="bi bi-credit-card me-1"></i><strong>Cuenta:</strong> @datos.Codigo
                    </p>
                    <p class="text-muted mb-1">
                        <i class="bi bi-coin me-1"></i><strong>Moneda:</strong> @(datos.Moneda == "01" ? "Soles" : "Dólares")
                    </p>
                    <p class="text-muted mb-0">
                        <i class="bi bi-envelope me-1"></i><strong>Email:</strong> @datos.EmailCliente
                    </p>
                </div>
                <div class="col-md-4 text-end">
                    <p class="text-muted mb-0">Saldo Disponible</p>
                    <h1 class="text-success fw-bold">@FormatoMoneda.Mostrar(datos.Saldo)</h1>
                </div>
            </div>
        </div>

        <!-- 2. Historial de Movimientos con Colores -->
        <div class="espe-card p-4">
            <h4 class="espe-title mb-3">
                <i class="bi bi-clock-history text-primary me-2"></i>Historial de Movimientos
            </h4>

            @if (movimientos == null || !movimientos.Any())
            {
                <div class="alert alert-info mb-0">No se encontraron movimientos para esta cuenta.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Número</th>
                                <th>Fecha</th>
                                <th>Tipo de Movimiento</th>
                                <th class="text-end">Importe</th>
                                <th class="text-end">Saldo</th> <!-- NUEVA COLUMNA -->
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in movimientos)
                            {
                                string tipoUpper = m.Tipo.ToUpper();

                                // 1. Identificar si es ingreso (Verde)
                                bool esIngreso = tipoUpper.Contains("DEP") ||
                                                 tipoUpper.Contains("APERTURA") ||
                                                 tipoUpper.Contains("INGRESO") ||
                                                 tipoUpper.Contains("ENTRADA");

                                // 2. Identificar si es retiro (Rojo)
                                bool esRetiro = tipoUpper.Contains("RET") ||
                                                tipoUpper.Contains("EGRESO") ||
                                                tipoUpper.Contains("SALIDA");

                                // 3. Colores y signos
                                string colorBadge = esIngreso ? "bg-success" : (esRetiro ? "bg-danger" : "bg-secondary");
                                string colorTexto = esIngreso ? "text-success" : (esRetiro ? "text-danger" : "text-secondary");
                                string icono = esIngreso ? "bi-arrow-down-left" : (esRetiro ? "bi-arrow-up-right" : "bi-arrow-left-right");
                                string signo = esIngreso ? "+" : (esRetiro ? "-" : "");

                                <tr>
                                    <td class="fw-bold">@m.Numero</td>
                                    <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @colorBadge">
                                            <i class="bi @icono me-1"></i>
                                            @m.Tipo
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold @colorTexto">
                                        @signo @FormatoMoneda.Mostrar(m.Importe)
                                    </td>
                                    <!-- NUEVA CELDA PARA EL SALDO -->
                                    <td class="text-end fw-bold text-dark">
                                        @FormatoMoneda.Mostrar(m.SaldoActual)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger">No se encontró la cuenta.</div>
    }
</div>

@code {
    [Parameter] public string cuenta { get; set; } = string.Empty;

    private DatosCuenta? datos;
    private List<MovimientoData> movimientos = new();
    private bool cargando = true;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        if (EstadoApp.TokenActual != "OK")
        {
            NavManager.NavigateTo("/");
            return;
        }

        try
        {
            var adaptador = Fabrica.ObtenerAdaptadorBanco(EstadoApp.BackendActual);

            // Obtener cuentas para sacar el detalle de la cuenta actual
            var cuentas = await adaptador.ObtenerCuentasAsync();
            datos = cuentas.FirstOrDefault(c => c.Codigo == cuenta);

            if (datos != null)
            {
                // Obtener los movimientos usando MovimientoData
                movimientos = await adaptador.ObtenerMovimientosAsync(cuenta);
            }
        }
        catch (Exception ex)
        {
            error = TraductorErrores.MensajeAmigable(ex, EstadoApp.BackendActual);
        }
        finally
        {
            cargando = false;
        }
    }
}