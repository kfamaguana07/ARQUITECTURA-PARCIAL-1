<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <add name="ComercializadoraConnStr" 
         connectionString="Server=.\SQLEXPRESS;Database=COMERCIALIZADORA_DB;User Id=Monster;Password=Monster9;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8"/>
  </system.web>

  <system.serviceModel>
    <!-- Configuración del cliente WCF hacia el Banco BanQuito -->
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IBanquitoService" 
                 maxBufferSize="2147483647" 
                 maxReceivedMessageSize="2147483647" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:9091/Services/BanquitoService.svc"
                binding="basicHttpBinding" 
                bindingConfiguration="BasicHttpBinding_IBanquitoService"
                contract="BanquitoServiceReference.IBanquitoService" 
                name="BasicHttpBinding_IBanquitoService" />
    </client>

    <!-- Exposición del Servicio WCF de la Comercializadora hacia .NET MAUI -->
    <services>
      <service name="WS_Comercializadora_Dotnet_Soap_GR01.Services.ComercializadoraService">
        <endpoint address="" 
                  binding="basicHttpBinding" 
                  contract="WS_Comercializadora_Dotnet_Soap_GR01.Contracts.IComercializadoraService" />
        <endpoint address="mex" 
                  binding="mexHttpBinding" 
                  contract="IMetadataExchange" />
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true"/>
    <directoryBrowse enabled="true"/>
  </system.webServer>

</configuration>