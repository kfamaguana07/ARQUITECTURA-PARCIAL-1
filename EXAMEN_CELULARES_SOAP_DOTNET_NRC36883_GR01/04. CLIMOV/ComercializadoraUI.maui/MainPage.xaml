<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ComercializadoraUI.maui"
             xmlns:components="clr-namespace:ComercializadoraUI.maui.Components"
             x:Class="ComercializadoraUI.maui.MainPage"
             Padding="{OnPlatform Android='0,36,0,0', iOS='0,44,0,0'}">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
