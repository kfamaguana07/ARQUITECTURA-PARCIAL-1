<nav class="navbar navbar-expand-lg navbar-dark custom-navbar shadow-sm px-3">
    <div class="container-fluid px-0 px-md-2">
        <!-- Logo / Marca -->
        <a class="navbar-brand d-flex align-items-center fw-bold" href="">
            <div class="brand-icon me-2">
                <i class="bi bi-phone-fill fs-5"></i>
            </div>
            <span class="brand-title">Comercializadora <span class="badge bg-primary rounded-pill fs-7 ms-1">Celulares</span></span>
        </a>

        <!-- Botón Menú Hamburguesa Móvil -->
        <button class="navbar-toggler border-0 shadow-none p-2" type="button" @onclick="ToggleNavMenu" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Elementos del Menú Desplegable -->
        <div class="@NavMenuCssClass navbar-collapse mt-2 mt-lg-0 justify-content-between" id="navbarNav">
            <ul class="navbar-nav ms-auto gap-1 gap-lg-2 py-2 py-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 position-relative" href="" Match="NavLinkMatch.All" @onclick="CerrarMenuEnMovil">
                        <i class="bi bi-house-door me-2"></i>Inicio
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 position-relative" href="productos" @onclick="CerrarMenuEnMovil">
                        <i class="bi bi-phone me-2"></i>Catálogo Celulares
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 position-relative" href="ventas" @onclick="CerrarMenuEnMovil">
                        <i class="bi bi-cart-check me-2"></i>Procesar Venta
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 position-relative" href="amortizacion" @onclick="CerrarMenuEnMovil">
                        <i class="bi bi-calculator me-2"></i>Amortización
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 position-relative" href="facturas" @onclick="CerrarMenuEnMovil">
                        <i class="bi bi-receipt me-2"></i>Historial Facturas
                    </NavLink>
                </li>
            </ul>

            <!-- Estado de Conexión / Badge Informativo -->
            <div class="mobile-badge-container d-flex align-items-center ms-lg-3 pt-3 pt-lg-0 border-top border-lg-0 border-secondary border-opacity-25">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill w-100 w-lg-auto text-center">
                    <i class="bi bi-bank me-1"></i> BanQuito Core OK
                </span>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CerrarMenuEnMovil()
    {
        collapseNavMenu = true;
    }
}