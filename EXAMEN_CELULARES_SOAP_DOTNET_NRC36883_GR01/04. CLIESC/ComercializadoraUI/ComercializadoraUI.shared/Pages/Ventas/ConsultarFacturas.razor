@page "/facturas"
@using ComercializadoraServiceReference
@using ComercializadoraUI.shared.Interfaces
@inject IVentaService VentaService

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center">
            <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                <i class="bi bi-receipt-cutoff fs-3"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Historial de Facturación</h3>
                <p class="text-muted small mb-0">Consulta de ventas procesadas en el sistema</p>
            </div>
        </div>
    </div>

    <!-- Buscador de Cédula -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               placeholder="Filtrar por Cédula del Cliente..."
                               @bind="cedulaFiltro"
                               @onkeydown="ManejarTeclado" />
                    </div>
                </div>
                <div class="col-12 col-md-auto ms-auto d-flex gap-2">
                    <button class="btn btn-outline-secondary w-100 w-md-auto" @onclick="LimpiarFiltro" disabled="@cargando">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Limpiar
                    </button>
                    <button class="btn btn-primary w-100 w-md-auto" @onclick="CargarFacturas" disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Buscando...</span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                            <span>Buscar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <AlertaResultado Mensaje="@mensajeAlerta" EsError="@esErrorAlerta" OnCerrar="LimpiarAlerta" />

    @if (cargando)
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
            <p class="text-muted mb-0">Cargando historial de ventas desde WCF...</p>
        </div>
    }
    else if (facturas == null || !facturas.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-inbox display-4 text-muted mb-3 opacity-50"></i>
            <h5 class="text-muted">No se encontraron facturas registradas</h5>
            <p class="text-muted small mb-0">Aún no se han emitido facturas o la búsqueda no arrojó resultados.</p>
        </div>
    }
    else
    {
        <!-- Acordeón para desplegar facturas e ítems del detalle -->
        <div class="accordion accordion-flush shadow-sm rounded-3 overflow-hidden" id="accordionFacturas">
            @foreach (var fact in facturas)
            {
                <div class="accordion-item border-bottom">
                    <h2 class="accordion-header" id="@($"heading-{fact.FacturaId}")">
                        <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="@($"#collapse-{fact.FacturaId}")">
                            <div class="row w-100 align-items-center me-2 g-2">
                                <div class="col-6 col-sm-3 col-md-2 fw-bold text-primary">
                                    <i class="bi bi-hash"></i>Factura #@fact.FacturaId
                                </div>
                                <div class="col-6 col-sm-4 col-md-3 small text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@fact.FechaVenta.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div class="col-6 col-sm-5 col-md-3 small">
                                    <i class="bi bi-person me-1"></i>CI: <strong>@fact.CedulaCliente</strong>
                                </div>
                                <div class="col-6 col-sm-6 col-md-2">
                                    @if (fact.FormaPago == "E")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                            <i class="bi bi-cash-coin me-1"></i>Efectivo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                            <i class="bi bi-credit-card me-1"></i>Crédito #@fact.CreditoId
                                        </span>
                                    }
                                </div>
                                <div class="col-12 col-sm-6 col-md-2 text-sm-end fw-bold fs-6 text-dark">
                                    $@fact.Total.ToString("N2")
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="@($"collapse-{fact.FacturaId}")" class="accordion-collapse collapse" data-bs-parent="#accordionFacturas">
                        <div class="accordion-body bg-light p-3 p-md-4">
                            <div class="card border-0 shadow-xs mb-3">
                                <div class="card-header bg-white py-2 fw-semibold small text-muted">
                                    <i class="bi bi-cart3 me-1"></i>Detalle de Productos
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3">Producto</th>
                                                <th class="text-center">Cantidad</th>
                                                <th class="text-end">Precio U.</th>
                                                <th class="text-end pe-3">Subtotal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (fact.Detalle != null)
                                            {
                                                @foreach (var det in fact.Detalle)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-medium">@det.ProductoNombre</td>
                                                        <td class="text-center">@det.Cantidad</td>
                                                        <td class="text-end">$@det.PrecioUnitario.ToString("N2")</td>
                                                        <td class="text-end pe-3 fw-bold">$@det.Subtotal.ToString("N2")</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Resumen Financiero -->
                            <div class="row justify-content-end">
                                <div class="col-12 col-md-5 col-lg-4">
                                    <div class="p-2 bg-white rounded border small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Subtotal:</span>
                                            <span>$@fact.Subtotal.ToString("N2")</span>
                                        </div>
                                        @if (fact.Descuento > 0)
                                        {
                                            <div class="d-flex justify-content-between mb-1 text-success">
                                                <span>Descuento (42%):</span>
                                                <span>-$@fact.Descuento.ToString("N2")</span>
                                            </div>
                                        }
                                        <hr class="my-1" />
                                        <div class="d-flex justify-content-between fw-bold fs-6 text-primary">
                                            <span>Total Pagado:</span>
                                            <span>$@fact.Total.ToString("N2")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<FacturaConsultaContract> facturas = new List<FacturaConsultaContract>();
    private string cedulaFiltro = string.Empty;
    private bool cargando = true;

    private string mensajeAlerta = string.Empty;
    private bool esErrorAlerta = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarFacturas();
    }

    private async Task CargarFacturas()
    {
        cargando = true;
        LimpiarAlerta();
        try
        {
            facturas = await VentaService.ObtenerHistorialFacturasAsync(
                string.IsNullOrWhiteSpace(cedulaFiltro) ? null : cedulaFiltro.Trim()
            );
        }
        catch (Exception ex)
        {
            MostrarError("Error al cargar el historial: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ManejarTeclado(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarFacturas();
        }
    }

    private async Task LimpiarFiltro()
    {
        cedulaFiltro = string.Empty;
        await CargarFacturas();
    }

    private void MostrarError(string m) { mensajeAlerta = m; esErrorAlerta = true; }
    private void LimpiarAlerta() { mensajeAlerta = string.Empty; }
}