@page "/ventas"
@using Microsoft.AspNetCore.Components.Forms
@using ComercializadoraUI.shared.Interfaces
@using ComercializadoraUI.shared.Models
@using ComercializadoraServiceReference
@using ComercializadoraUI.shared.Components
@inject IProductoService ProductoService
@inject IVentaService VentaService

<div class="ventas-wrapper">
    <!-- Header adaptativo con degradado -->
    <div class="ventas-header mb-4">
        <div class="d-flex align-items-center">
            <div class="header-icon">
                <i class="bi bi-cart-check-fill"></i>
            </div>
            <div>
                <h2 class="mb-0 fw-bold header-title">Facturación y Ventas</h2>
                <p class="mb-0 opacity-75 small">Sistema de venta de teléfonos</p>
            </div>
        </div>
    </div>

    <AlertaResultado Mensaje="@mensajeAlerta" EsError="@esErrorAlerta" OnCerrar="LimpiarAlerta" />

    <div class="row g-3 g-md-4">
        <!-- Columna del Formulario -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100 card-form">
                <div class="card-header card-header-custom">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-pencil-square me-2 fs-5 text-primary"></i>
                        <h5 class="mb-0 fw-semibold fs-6 fs-md-5">Datos de la Venta</h5>
                    </div>
                </div>
                <div class="card-body p-3 p-md-4">
                    <EditForm Model="solicitudModel" OnValidSubmit="EjecutarVenta">
                        <DataAnnotationsValidator />

                        <!-- Paso 1: Cliente -->
                        <div class="form-step mb-3 mb-md-4">
                            <div class="step-indicator">
                                <span class="step-badge">1</span>
                                <span class="step-label">Identificación del Cliente</span>
                            </div>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light"><i class="bi bi-person-vcard"></i></span>
                                <InputText class="form-control"
                                           @bind-Value="solicitudModel.CedulaCliente"
                                           placeholder="Ej: 1727578104" />
                            </div>
                            <ValidationMessage For="@(() => solicitudModel.CedulaCliente)" class="text-danger small d-block mt-1" />
                        </div>

                        <!-- Paso 2: Producto -->
                        <div class="form-step mb-3 mb-md-4">
                            <div class="step-indicator">
                                <span class="step-badge">2</span>
                                <span class="step-label">Seleccionar Producto</span>
                            </div>
                            <InputSelect class="form-select form-select-lg"
                                         @bind-Value="solicitudModel.ProductoId"
                                         @bind-Value:after="OnProductoCambiado">
                                <option value="0">-- Seleccione un teléfono --</option>
                                @foreach (var item in catalogo)
                                {
                                    <option value="@item.ProId">@item.ProNombre — $@item.ProPrecio.ToString("N2")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => solicitudModel.ProductoId)" class="text-danger small d-block mt-1" />

                            @if (precioSeleccionado > 0)
                            {
                                <div class="product-preview mt-2">
                                    <i class="bi bi-phone me-1"></i>
                                    <strong>Precio base:</strong> $@precioSeleccionado.ToString("N2")
                                </div>
                            }
                        </div>

                        <!-- Paso 3: Forma de pago -->
                        <div class="form-step mb-3 mb-md-4">
                            <div class="step-indicator">
                                <span class="step-badge">3</span>
                                <span class="step-label">Forma de Pago</span>
                            </div>

                            <InputRadioGroup @bind-Value="solicitudModel.FormaPago">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="payment-option @(solicitudModel.FormaPago == "E" ? "selected" : "")">
                                            <InputRadio Value='"E"' class="d-none" />
                                            <i class="bi bi-cash-coin fs-3 fs-md-4 d-block mb-1 text-success"></i>
                                            <span class="fw-bold d-block option-title">Efectivo</span>
                                            <small class="text-success fw-semibold option-subtitle">-42% descuento</small>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <label class="payment-option @(solicitudModel.FormaPago == "C" ? "selected" : "")">
                                            <InputRadio Value='"C"' class="d-none" />
                                            <i class="bi bi-credit-card fs-3 fs-md-4 d-block mb-1 text-primary"></i>
                                            <span class="fw-bold d-block option-title">Crédito</span>
                                            <small class="text-primary fw-semibold option-subtitle">BanQuito WCF</small>
                                        </label>
                                    </div>
                                </div>
                            </InputRadioGroup>
                        </div>

                        <!-- Resumen dinámico -->
                        @if (solicitudModel.FormaPago == "E" && precioSeleccionado > 0)
                        {
                            <div class="summary-box summary-success mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted"><i class="bi bi-tag-fill me-1"></i>Precio original</span>
                                    <s class="text-muted">$@precioSeleccionado.ToString("N2")</s>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold">Descuento (42%)</span>
                                    <span class="text-danger">-$@((precioSeleccionado * 0.42m).ToString("N2"))</span>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold fs-6">Total a Pagar</span>
                                    <span class="fw-bold fs-4 text-success">$@((precioSeleccionado * 0.58m).ToString("N2"))</span>
                                </div>
                            </div>
                        }
                        else if (solicitudModel.FormaPago == "C")
                        {
                            <div class="form-step mb-3">
                                <div class="step-indicator">
                                    <span class="step-badge">4</span>
                                    <span class="step-label">Plazo en Meses</span>
                                </div>
                                <InputSelect class="form-select form-select-lg" @bind-Value="solicitudModel.NumeroCuotas">
                                    @for (int i = 3; i <= 18; i++)
                                    {
                                        <option value="@i">@i Meses</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => solicitudModel.NumeroCuotas)" class="text-danger small d-block mt-1" />
                            </div>
                        }

                        <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mt-2 btn-submit" disabled="@procesando">
                            @if (procesando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>Procesando transacción...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-receipt-cutoff me-2"></i>Procesar Facturación</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Columna de Resultado -->
        <div class="col-lg-6">
            @if (respuestaUltimaVenta != null && respuestaUltimaVenta.Exitosa)
            {
                <div class="card border-0 shadow-sm card-success h-100">
                    <div class="card-header card-header-success">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <h5 class="mb-0 fw-semibold fs-6 fs-md-5">Factura Generada</h5>
                        </div>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <div class="result-row">
                            <span class="result-label"><i class="bi bi-hash me-1"></i>N° Factura</span>
                            <span class="badge bg-dark fs-6 px-3 py-2">@respuestaUltimaVenta.FacturaId</span>
                        </div>
                        <div class="result-row">
                            <span class="result-label"><i class="bi bi-currency-dollar me-1"></i>Monto Procesado</span>
                            <span class="fs-4 fw-bold text-success">$@respuestaUltimaVenta.TotalPagar.ToString("N2")</span>
                        </div>
                        @if (respuestaUltimaVenta.CreditoId.HasValue)
                        {
                            <div class="result-row">
                                <span class="result-label"><i class="bi bi-bank me-1"></i>Código Crédito</span>
                                <span class="badge bg-primary fs-6 px-3 py-2">#@respuestaUltimaVenta.CreditoId.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm h-100 placeholder-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-4 p-md-5">
                        <i class="bi bi-receipt display-1 text-muted opacity-50 mb-3 fs-2 fs-md-1"></i>
                        <h5 class="text-muted fs-6 fs-md-5">Sin factura generada</h5>
                        <p class="text-muted small mb-0">Completa el formulario para generar una nueva factura.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (respuestaUltimaVenta != null && respuestaUltimaVenta.TablaAmortizacion != null && respuestaUltimaVenta.TablaAmortizacion.Any())
    {
        <div class="mt-4">
            <TablaAmortizacionComponent Tabla="@respuestaUltimaVenta.TablaAmortizacion" CodigoCredito="@(respuestaUltimaVenta.CreditoId ?? 0)" />
        </div>
    }
</div>

@code {
    private List<Producto> catalogo = new List<Producto>();
    private SolicitudVentaViewModel solicitudModel = new SolicitudVentaViewModel();
    private RespuestaVenta respuestaUltimaVenta;
    private decimal precioSeleccionado = 0m;
    private bool procesando = false;

    private string mensajeAlerta = string.Empty;
    private bool esErrorAlerta = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            catalogo = await ProductoService.ObtenerCatalogoAsync();
        }
        catch (Exception ex)
        {
            MostrarError("Error cargando productos: " + ex.Message);
        }
    }

    private void OnProductoCambiado()
    {
        var prod = catalogo.FirstOrDefault(p => p.ProId == solicitudModel.ProductoId);
        precioSeleccionado = prod != null ? prod.ProPrecio : 0m;
    }

    private async Task EjecutarVenta()
    {
        procesando = true;
        LimpiarAlerta();
        respuestaUltimaVenta = null;

        try
        {
            var req = new SolicitudVentaRequest
            {
                CedulaCliente = solicitudModel.CedulaCliente,
                ProductoId = solicitudModel.ProductoId,
                FormaPago = solicitudModel.FormaPago,
                NumeroCuotas = solicitudModel.NumeroCuotas
            };

            respuestaUltimaVenta = await VentaService.ProcesarVentaAsync(req);

            if (respuestaUltimaVenta.Exitosa)
                MostrarExito(respuestaUltimaVenta.Mensaje);
            else
                MostrarError(respuestaUltimaVenta.Mensaje);
        }
        catch (Exception ex)
        {
            MostrarError("Error SOAP al procesar la venta: " + ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }

    private void MostrarExito(string m) { mensajeAlerta = m; esErrorAlerta = false; }
    private void MostrarError(string m) { mensajeAlerta = m; esErrorAlerta = true; }
    private void LimpiarAlerta() { mensajeAlerta = string.Empty; }
}