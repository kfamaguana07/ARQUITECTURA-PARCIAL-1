@page "/amortizacion"
@using ComercializadoraUI.shared.Interfaces
@using ComercializadoraServiceReference
@using ComercializadoraUI.shared.Components
@using Microsoft.AspNetCore.Components.Web
@inject IAmortizacionService AmortizacionService

<div class="amortizacion-wrapper">
    <!-- Header adaptativo con degradado -->
    <div class="amortizacion-header mb-4">
        <div class="d-flex align-items-center">
            <div class="header-icon">
                <i class="bi bi-calculator-fill"></i>
            </div>
            <div>
                <h2 class="mb-0 fw-bold header-title">Consulta de Amortización</h2>
                <p class="mb-0 opacity-75 small">Consulta la tabla de pagos de un crédito</p>
            </div>
        </div>
    </div>

    <!-- Tarjeta de búsqueda -->
    <div class="card border-0 shadow-sm card-busqueda mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="step-indicator mb-3">
                <span class="step-badge"><i class="bi bi-search"></i></span>
                <span class="step-label">Buscar Crédito</span>
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-md-8 col-lg-6">
                    <label class="form-label-custom">
                        <i class="bi bi-hash me-1"></i>Código de Crédito
                    </label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-bank"></i></span>
                        <input type="number"
                               class="form-control"
                               @bind="codigoCreditoBusqueda"
                               placeholder="Ej: 1"
                               min="1"
                               @onkeydown="OnKeyDownBuscar" />
                    </div>
                </div>
                <div class="col-md-4 col-lg-auto">
                    <button class="btn btn-submit btn-lg w-100 py-3 py-md-2" @onclick="Consultar" disabled="@buscando">
                        @if (buscando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span><span>Consultando...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-search me-2"></i>Consultar Crédito</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <AlertaResultado Mensaje="@mensajeAlerta" EsError="@esErrorAlerta" OnCerrar="LimpiarAlerta" />

    @if (tablaAmortizacion != null && tablaAmortizacion.Any())
    {
        <TablaAmortizacionComponent Tabla="@tablaAmortizacion" CodigoCredito="@codigoCreditoBusqueda" />
    }
    else if (!buscando && string.IsNullOrEmpty(mensajeAlerta))
    {
        <!-- Estado inicial -->
        <div class="card border-0 shadow-sm placeholder-card">
            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-4 p-md-5">
                <i class="bi bi-calendar3 display-1 text-muted opacity-50 mb-3 fs-2 fs-md-1"></i>
                <h5 class="text-muted fs-6 fs-md-5">Sin consulta realizada</h5>
                <p class="text-muted small mb-0">Ingresa un código de crédito y presiona <strong>Consultar</strong> para ver la tabla de amortización.</p>
            </div>
        </div>
    }
</div>

@code {
    private int codigoCreditoBusqueda = 1;
    private List<CuotaAmortizacion> tablaAmortizacion;
    private bool buscando = false;

    private string mensajeAlerta = string.Empty;
    private bool esErrorAlerta = false;

    private async Task Consultar()
    {
        if (codigoCreditoBusqueda <= 0)
        {
            MostrarError("Ingrese un código de crédito válido mayor a cero.");
            return;
        }

        buscando = true;
        LimpiarAlerta();
        tablaAmortizacion = null;

        try
        {
            tablaAmortizacion = await AmortizacionService.ConsultarAmortizacionAsync(codigoCreditoBusqueda);
            if (tablaAmortizacion == null || !tablaAmortizacion.Any())
            {
                MostrarError($"No se encontraron datos de amortización para el crédito #{codigoCreditoBusqueda}.");
            }
        }
        catch (Exception ex)
        {
            MostrarError("Error WCF: " + ex.Message);
        }
        finally
        {
            buscando = false;
        }
    }

    private async Task OnKeyDownBuscar(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !buscando)
        {
            await Consultar();
        }
    }

    private void MostrarError(string m) { mensajeAlerta = m; esErrorAlerta = true; }
    private void LimpiarAlerta() { mensajeAlerta = string.Empty; }
}